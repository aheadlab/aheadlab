# Workspace-only shortcut: reuses the existing offline validation environment.
FROM aheadlab-capacity-validation
WORKDIR /project
ENV PYTHONPATH=/project/src PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1
COPY src/ ./src/
COPY results/ ./results/
COPY docs/ ./docs/
COPY web/dist/ ./web/dist/
EXPOSE 8501
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/api/health', timeout=3)"
CMD ["python","-m","uvicorn","carbonshift.api:app","--host","0.0.0.0","--port","8501"]
